{
  "name": "empire",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "npm run dev -w @empire/client",
    "dev:server": "npm run dev -w @empire/server",
    "build": "npm run build -w @empire/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
